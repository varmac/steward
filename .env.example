# Copy to .env.local. Never commit .env.local.

# Model access for local development. A Vercel deployment uses the project's
# OIDC identity instead, so production needs no model key.
AI_GATEWAY_API_KEY=

# The one phone number allowed to talk to the assistant, in E.164 form.
# Missing or malformed means nobody gets through.
OWNER_PHONE=+14155550123

# Optional. IANA zone for dates and the morning brief. Default America/Los_Angeles.
OWNER_TIMEZONE=

# Receipts log (Postgres). Without it, receipts print to the console.
DATABASE_URL=

# Cloud browser for the browser worker.
KERNEL_API_KEY=
# Optional: persistent profile name (default steward-owner) and stealth mode.
KERNEL_PROFILE=
KERNEL_STEALTH=

# Optional overrides for Vercel Connect connector UIDs.
LINQ_CONNECTOR=linq/steward
GOOGLE_CONNECTOR=google/steward
GITHUB_CONNECTOR=github/steward

# The owner's Linq thread id. Required for the morning brief; it is logged as
# "[steward] owner thread id: ..." on the owner's first message after a deploy.
LINQ_OWNER_CHAT_ID=

# Set by `eve add memory/file` on Vercel.
EVE_MEMORY_BLOB_STORE_ID=
