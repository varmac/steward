    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vercel": "^59.23.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "24.x"
